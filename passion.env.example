# Credentials for the Passion tech skills.
#
# Copy to ~/.claude/passion.env and fill in. That path is deliberate: it is
# outside every repository, so these values cannot be committed by accident.
#
# One KEY=value per line. Real environment variables win over this file, so
# anything already exported in your shell is used instead.
#
# Fill in only what your department needs. A skill that needs a value you have
# left blank will tell you which one it wants.

# ── Jira — everyone ──────────────────────────────────────────────────────────
# Your Atlassian site URL, no trailing slash.
JIRA_BASE_URL=
# The email address you sign in to Jira with.
JIRA_EMAIL=
# Create at https://id.atlassian.com/manage/api-tokens — this is a token, not
# your password.
JIRA_API_TOKEN=
# Optional. The project key you work in, so `sprint` does not need --project.
JIRA_PROJECT=

# ── Rock RMS — local engineering, analytics, service and support ─────────────
# Your Rock instance URL, https, no trailing path. Ask whoever administers
# Rock; do not guess it.
ROCK_BASE_URL=
# A Rock account with admin access.
ROCK_USERNAME=
ROCK_PASSWORD=
